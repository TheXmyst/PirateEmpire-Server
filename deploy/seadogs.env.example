# Configuration du serveur SeaDogs en production.
# À copier dans /etc/seadogs/seadogs.env (lisible uniquement par root et seadogs).

# Clé qui signe les jetons de connexion. OBLIGATOIRE, 32 caractères minimum.
# Génère-la avec :  openssl rand -hex 32
# Ne la partage jamais et ne la mets pas sur GitHub. Si tu la changes, tous
# les joueurs devront simplement se reconnecter.
AUTH_SECRET=

# Le serveur n'écoute qu'en local : on ne peut l'atteindre qu'en passant par
# le reverse proxy (Caddy ou nginx), donc en HTTPS.
# Port 8090 pour ne pas gêner un autre service sur 8080. S'il est déjà pris
# sur ton VPS, choisis-en un libre (vérifie avec : ss -tlnp) et mets le même
# dans la config du reverse proxy.
LISTEN_ADDR=127.0.0.1:8090

# Routes de triche pour les tests (ajout de ressources, saut dans le temps...).
# Toujours false en production.
DEV_ROUTES_ENABLED=false

# Sauvegarde du monde en mémoire vers la base, en secondes.
WORLD_SAVE_INTERVAL_SECONDS=5
